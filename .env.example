# Copy to .env.local. Server-only placeholders; never use NEXT_PUBLIC_.
# Both Google adapters use this key. Replace any previously exposed key.
GEMMA_API_KEY=

# Optional overrides: uncomment and fill only when needed.
# Omit them to use the server adapters' default models and Google endpoint.
# GEMMA_MODEL=
# GEMMA_BASE_URL=
# VISION_MODEL=
